# Copy this file to .env and fill in your values for local development.
# On Render you set these in Dashboard -> Environment instead.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: Supadata API key (free plan at https://supadata.ai) that lets the
# server fetch transcripts itself even when YouTube blocks its IP.
# Without it, users paste the transcript manually when blocked.
# SUPADATA_API_KEY=your_key_here
# Optional: route YouTube transcript requests through a proxy
# (useful on hosts whose IP is blocked by YouTube, e.g. cloud servers).
# TRANSCRIPT_PROXY=http://user:pass@host:port
